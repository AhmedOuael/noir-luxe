generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               BigInt               @id @default(autoincrement())
  email            String               @unique
  name             String               @default("")
  passwordHash     String
  role             String               @default("STAFF") // ADMIN | STAFF (confirmation team)
  active           Boolean              @default(true)
  failedLoginCount Int                  @default(0)
  lockedUntil      DateTime?            @db.Timestamptz(3)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)
  statusHistory    OrderStatusHistory[]
  sessions         Session[]
}

// Admin dashboard login sessions. The cookie holds a random token; only its
// SHA-256 hash is stored, so a DB leak doesn't expose usable sessions.
model Session {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Product {
  id          BigInt            @id @default(autoincrement())
  slug        String            @unique
  name        String
  description String?
  details     String[]          @default([])
  limited     Boolean           @default(false)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)
  categories  ProductCategory[]
  images      ProductImage[]
  variants    ProductVariant[]
}

model Category {
  id        BigInt            @id @default(autoincrement())
  name      String            @unique
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  products  ProductCategory[]
}

model ProductCategory {
  productId  BigInt
  categoryId BigInt
  category   Category @relation(fields: [categoryId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductImage {
  id           BigInt   @id @default(autoincrement())
  productId    BigInt
  imageUrl     String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
}

model ProductVariant {
  id            BigInt   @id @default(autoincrement())
  productId     BigInt
  color         String?
  size          String?
  sku           String   @unique
  price         Decimal  @db.Decimal(10, 2)
  physicalStock Int      @default(0)
  reservedStock Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Wilaya {
  id        BigInt     @id @default(autoincrement())
  code      String     @unique
  name      String     @unique
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)
  customers Customer[]
  communes  Commune[]
  orders    Order[]
}

// Filled from the delivery company's commune list.
model Commune {
  id        BigInt   @id @default(autoincrement())
  wilayaId  BigInt
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  wilaya    Wilaya   @relation(fields: [wilayaId], references: [id])
  orders    Order[]

  @@unique([wilayaId, name])
}

model Customer {
  id        BigInt   @id @default(autoincrement())
  fullName  String
  phone     String
  wilayaId  BigInt
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  wilaya    Wilaya   @relation(fields: [wilayaId], references: [id])
  orders    Order[]

  @@index([phone])
  @@index([wilayaId])
}

model Order {
  id            BigInt               @id @default(autoincrement())
  customerId    BigInt
  // Delivery destination is per order: a returning customer may ship elsewhere.
  wilayaId      BigInt
  deliveryType  String // HOME | STOP_DESK, chosen at checkout
  // Filled by the confirmation team during the call.
  communeId     BigInt?
  address       String?
  subtotal      Decimal              @db.Decimal(10, 2)
  deliveryFee   Decimal              @db.Decimal(10, 2)
  discount      Decimal              @default(0) @db.Decimal(10, 2)
  total         Decimal              @db.Decimal(10, 2)
  status        String               @default("NEW")
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  customer      Customer             @relation(fields: [customerId], references: [id])
  wilaya        Wilaya               @relation(fields: [wilayaId], references: [id])
  commune       Commune?             @relation(fields: [communeId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([customerId])
  @@index([wilayaId])
  @@index([communeId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                    BigInt         @id @default(autoincrement())
  orderId               BigInt
  variantId             BigInt
  quantity              Int
  priceAtPurchase       Decimal        @db.Decimal(10, 2)
  productNameAtPurchase String
  colorAtPurchase       String?
  sizeAtPurchase        String?
  createdAt             DateTime       @default(now()) @db.Timestamptz(3)
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant               ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id            BigInt   @id @default(autoincrement())
  orderId       BigInt
  status        String
  changedBy     BigInt?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  changedByUser User?    @relation(fields: [changedBy], references: [id])
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([changedBy])
}
